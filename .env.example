# Banco local (Docker Compose). Ajuste se mudar as credenciais no docker-compose.yml.
DATABASE_URL="postgresql://leadfinder:leadfinder@localhost:5432/leadfinder?schema=public"

# Em produção (Neon/Vercel), a Vercel injeta DATABASE_URL (pooled) e
# DATABASE_URL_UNPOOLED (direta, usada pelo Prisma para rodar migrations).
# Em dev local com Docker, pode deixar as duas iguais ou omitir a segunda.
DATABASE_URL_UNPOOLED="postgresql://leadfinder:leadfinder@localhost:5432/leadfinder?schema=public"

# Senha única para acessar o app (gate simples em middleware.ts).
# Defina um valor forte em produção — sem isso ninguém consegue logar.
APP_PASSWORD="troque-esta-senha"
